# ---------------------------------------------------------------------------
# Fondation Musk — Variables d'environnement
# ---------------------------------------------------------------------------
# 1. Copiez ce fichier en `.env`
# 2. Remplissez les valeurs depuis votre tableau de bord Supabase
#    (Project Settings -> API Keys)
# ---------------------------------------------------------------------------

# URL du projet Supabase (ex: https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Clé publique "anon" (safe à exposer côté navigateur)
VITE_SUPABASE_ANON_KEY=

# Code d'accès à l'espace administrateur (/admin).
# Changez-le ! Ceci est une protection simple côté client.
VITE_ADMIN_PASSCODE=fondation-musk-2026
